# Image and host binding
JIESHAN_IMAGE=ghcr.io/lutiantian001/jieshan:latest
# Give both a unique value when testing an isolated instance beside an older
# container. The defaults preserve the normal single-instance deployment.
JIESHAN_CONTAINER_NAME=jieshan
JIESHAN_DATA_VOLUME=jieshan-data
JIESHAN_BIND_IP=127.0.0.1
JIESHAN_PORT=4000

# Optional first-run credentials. When omitted, JieShan generates them inside
# the persistent data volume. The generated administrator password is written
# to /data/initial-admin-password.txt and the encryption key is never logged.
JIESHAN_ADMIN_PASSWORD=
JIESHAN_SECRET_KEY=

# Browser security. The default deployment is loopback-bound behind HTTPS.
JIESHAN_TRUST_PROXY=true
# Leave empty to infer HTTPS from TLS or the trusted X-Forwarded-Proto header.
JIESHAN_SECURE_COOKIES=
# Comma-separated external origins when the panel is accessed through a domain.
# Example: https://api.example.com
JIESHAN_ALLOWED_ORIGINS=

# Upstream transport and SSRF policy
JIESHAN_ALLOW_PRIVATE_UPSTREAMS=false
JIESHAN_UPSTREAM_DIAL_TIMEOUT=10s
JIESHAN_UPSTREAM_TIMEOUT=60s
JIESHAN_UPSTREAM_MAX_CONNS_PER_HOST=12

# SQLite uses one writer. A small pool avoids lock contention and leaves file
# descriptors and memory for streaming requests and the co-located proxy.
JIESHAN_DB_MAX_OPEN_CONNS=4
JIESHAN_DB_MAX_IDLE_CONNS=2

# Deterministic failover. A request switches immediately, while a route enters
# cooldown only after the configured number of target-scoped failures.
JIESHAN_FAILURE_THRESHOLD=2
JIESHAN_FAILURE_WINDOW=5m
JIESHAN_COOLDOWN=5m
JIESHAN_HALF_OPEN_LEASE=30s
JIESHAN_CREDENTIAL_COOLDOWN=5m
JIESHAN_FIRST_OUTPUT_TIMEOUT=15s
JIESHAN_STREAM_IDLE_TIMEOUT=60s
JIESHAN_REQUEST_TIMEOUT=5m
JIESHAN_MAX_ATTEMPTS=4

# Active monitoring. The persisted global probe interval schedules only models
# selected for monitoring; these values bound execution on a shared 2C2G host.
JIESHAN_PROBE_TIMEOUT=30s
JIESHAN_PROBE_MAX_CONCURRENT_MODELS=1
JIESHAN_PROBE_MAX_CONCURRENT_TARGETS=2

JIESHAN_SESSION_TTL=24h
JIESHAN_LOG_LEVEL=info
TZ=Asia/Shanghai

# Conservative container limits for a 2C2G host shared with Caddy and Mihomo.
JIESHAN_MEMORY_LIMIT=768m
JIESHAN_MEMORY_SWAP_LIMIT=896m
JIESHAN_GO_MEMORY_LIMIT=560MiB
JIESHAN_GO_MAX_PROCS=2
JIESHAN_CPU_LIMIT=1.5
