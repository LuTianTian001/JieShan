# Compose image and host binding
JIESHAN_IMAGE=ghcr.io/lutiantian001/jieshan:latest
JIESHAN_BIND_IP=127.0.0.1
JIESHAN_PORT=4000

# Required on every start. JieShan enforces this password at startup.
JIESHAN_ADMIN_PASSWORD=replace-with-a-long-random-password

# Required: 32 random bytes encoded as 64 hexadecimal characters.
# Generate with: openssl rand -hex 32
JIESHAN_SECRET_KEY=replace-with-64-hex-characters

# Runtime behavior
JIESHAN_LOG_LEVEL=info
# Keep true when the loopback-bound service is behind the documented Caddy
# proxy. Set false if requests reach JieShan without a trusted reverse proxy.
JIESHAN_TRUST_PROXY=true
# Keep false for public relay sites. Enable only when you intentionally connect
# JieShan to an upstream on your own private network.
JIESHAN_ALLOW_PRIVATE_UPSTREAMS=false
JIESHAN_SESSION_TTL=24h
JIESHAN_UPSTREAM_TIMEOUT=60s
TZ=Asia/Shanghai

# Conservative defaults for a 2-core, 1 GB host shared with Caddy/sing-box.
JIESHAN_MEMORY_LIMIT=640m
# Total memory plus swap available to the container.
JIESHAN_MEMORY_SWAP_LIMIT=768m
JIESHAN_GO_MEMORY_LIMIT=480MiB
JIESHAN_CPU_LIMIT=1.5
